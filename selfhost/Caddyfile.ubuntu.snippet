# DX-TRACE | Additional Caddy sites for an existing Ubuntu host Caddy.
# @Project DX-TRACE
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 DX-TRACE contributors
#
# Append to /etc/caddy/Caddyfile, without altering any existing site blocks.
# Requires Docker Compose services at 127.0.0.1:8180, 8181 and 8182.

app.example.org {
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    header X-Content-Type-Options nosniff

    @device {
        method POST
        path /api/ingest
    }
    handle @device {
        reverse_proxy 127.0.0.1:8182 {
            header_up -X-Forwarded-User
            header_up -X-Forwarded-Email
            header_up -X-Forwarded-Groups
            header_up -X-Forwarded-Preferred-Username
            header_up -X-DX-Core-Token
        }
    }
    handle {
        reverse_proxy 127.0.0.1:8180 {
            header_up -X-Forwarded-User
            header_up -X-Forwarded-Email
            header_up -X-Forwarded-Groups
            header_up -X-Forwarded-Preferred-Username
            header_up -X-DX-Core-Token
        }
    }
}

id.example.org {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8181 {
        header_up -X-Forwarded-User
        header_up -X-Forwarded-Email
        header_up -X-Forwarded-Groups
        header_up -X-Forwarded-Preferred-Username
        header_up -X-DX-Core-Token
    }
}
